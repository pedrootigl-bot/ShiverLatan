REACTBITS_LICENSE_KEY=

# URL canônica em produção, sem barra no final.
# Usada em sitemap, robots.txt, Open Graph e JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com

# Código da meta google-site-verification (Search Console).
GOOGLE_SITE_VERIFICATION=

# Obrigatório em produção para POST /api/signals/test (header x-signal-test-secret).
# Em desenvolvimento o endpoint de teste fica aberto.
SIGNAL_TEST_SECRET=

# Telegram (webhook futuro). Nunca use prefixo NEXT_PUBLIC_ nestes valores.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
